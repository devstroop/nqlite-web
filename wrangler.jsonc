{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nqlite-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview` (open beta): may stay empty, assets
  // and compatibility settings remain top-level.
  "previews": {},
  "observability": {
    "enabled": true
  }
}
